{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Render Worker Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "input"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 100},
    "title": {"type": "string", "maxLength": 200},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_video": {"type": "string"},
        "base_video": {"type": "string"},
        "edl": {"type": "string"},
        "timeline": {"type": "string"},
        "asset_manifest": {"type": "string", "description": "Path to asset_manifest.json containing direct HTTP(S) media URLs."}
      },
      "oneOf": [
        {"required": ["source_video"], "not": {"required": ["base_video"]}},
        {"required": ["base_video"], "not": {"required": ["source_video"]}}
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {"type": "integer", "default": 1080},
        "height": {"type": "integer", "default": 1920},
        "fps": {"type": "integer", "default": 30},
        "video_codec": {"const": "h264"},
        "pixel_format": {"const": "yuv420p"},
        "audio_codec": {"const": "aac"}
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "crf": {"type": "integer", "minimum": 0, "maximum": 51},
        "preset": {"enum": ["ultrafast", "fast", "medium", "slow"]},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    }
  }
}
