{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remotion Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "layers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "start", "end"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["caption", "bubble", "zoom", "flash", "meme", "broll"]},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "text": {"type": ["string", "null"]},
          "asset_id": {"type": "string", "description": "Required for meme and broll cues; must match asset_manifest.json."},
          "position": {"enum": ["top", "center", "bottom"]},
          "scale": {"type": "number", "minimum": 1.0, "maximum": 1.3},
          "x": {"type": "number", "minimum": 0, "maximum": 100},
          "y": {"type": "number", "minimum": 0, "maximum": 100},
          "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
          "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
          "opacity": {"type": "number", "minimum": 0, "maximum": 1},
          "fit": {"enum": ["cover", "contain", "fill"]},
          "style": {"type": "object"}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"enum": ["meme", "broll"]}}, "required": ["type"]},
            "then": {"required": ["asset_id"]}
          },
          {
            "if": {"properties": {"type": {"enum": ["caption", "bubble"]}}, "required": ["type"]},
            "then": {"required": ["text"]}
          }
        ]
      }
    }
  }
}
