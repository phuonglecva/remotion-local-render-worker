# Recommended for a personal Google Drive (OAuth Desktop app credentials JSON)
GOOGLE_OAUTH_CLIENT_FILE=/absolute/path/to/oauth-desktop-client.json
GOOGLE_TOKEN_FILE=var/google-token.json

# Optional: service account is supported only when the mailbox is in a Google Shared Drive.
# GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/google-drive-service-account.json

DRIVE_MAILBOX_ROOT_ID=replace_with_mailbox_root_folder_id

WORKER_DATABASE=var/worker.sqlite3
WORKER_WORK_DIR=var/work
WORKER_LOG_DIR=var/logs
WORKER_POLL_INTERVAL_SECONDS=15
WORKER_MAX_JOBS_PER_POLL=2

# Remote audio / meme / B-roll downloads. HTTPS only by default.
ASSET_DOWNLOAD_TIMEOUT_SECONDS=30
ASSET_DOWNLOAD_MAX_BYTES=536870912
ASSET_DOWNLOAD_ALLOW_HTTP=false

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
NODE_BIN=node
NPM_BIN=npm
REMOTION_DIR=remotion
